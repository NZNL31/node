# 服务器上运行的配置模板：复制成 .env（已在 .gitignore 里），不要提交
#
#   cp deploy/env.example .env
#   chmod 600 .env

# --- 发布方式 --------------------------------------------------------------
# none = 只在服务器上产出 v2.txt（配合 nginx 静态托管 / 或你手动取走）
# git  = 直接提交推送到 GitHub（需要能 push 的凭据，见下）
PUBLISH=none

# PUBLISH=git 时用：
# GIT_AUTHOR_NAME=node-bot
# GIT_AUTHOR_EMAIL=node-bot@localhost
# 用 token 推送（https）：
#   git remote set-url origin https://x-access-token:${GITHUB_TOKEN}@github.com/NZNL31/node.git

# --- 探活/校验 -------------------------------------------------------------
# sing-box 不存在时 run.sh 会自动下载
SINGBOX_VERSION=1.14.4
SINGBOX_BIN=./sing-box

# 探活：并发与超时
MAX_PROBE=6000
PROBE_CONCURRENCY=64
PROBE_TIMEOUT_MS=4000

# 协议级校验（TCP 走 204，UDP 走 STUN）
VERIFY_SLOTS=24
VERIFY_TIMEOUT=8
# 端口段被占用时换一个（例如 Windows 保留段、或已被别的服务占用）
# VERIFY_PORT_BASE=15000

# 输出上限、淘汰节奏
MAX_OUTPUT=1500
DEAD_ROUNDS=2
MIN_KEEP=150

# 香港探测（check-host.net，约 50 次后限流）
HK_BATCH=50
HK_TTL_H=96
HK_PRUNE_DAYS=30

# 单源上限（巨型 dump 兜底）
SOURCE_LIMIT=1200
# --- 出口 IP 纯净度（结合 NZNL31/ipquality）--------------------------------
# 1 = 每轮都经节点查出口 IP 并打分，把 [A 96] 这样的标记写进节点名
PURITY=0
# ipquality 仓库位置（git clone 到项目旁边即可）
IPQUALITY_DIR=../ipquality
# 低于这个分数直接丢弃（0 = 只标注不筛）
PURITY_MIN=0
# 同一个出口 IP 的分数缓存多少天
PURITY_CACHE_DAYS=7
# 选优选：按纯净度挑出 N 个，输出 top{N}.txt（0 = 不选，只发全量 v2.txt）
# 数量由调用方决定，例如 TOP_N=80 ./run.sh；产物只留在本机，不提交
TOP_N=0
# 评分并发（ip-api 45 次/分、IPQS 35 次/天，别调太高）
PURITY_CONCURRENCY=4