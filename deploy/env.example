# 服务器上运行的配置模板：复制成 .env（已在 .gitignore 里），不要提交
#
#   cp deploy/env.example .env
#   chmod 600 .env

# --- 发布方式 --------------------------------------------------------------
# none = 只在服务器上产出 v2.txt（配合 nginx 静态托管 / 或你手动取走）
# git  = 直接提交推送到 GitHub（需要能 push 的凭据，见下）
PUBLISH=none

# PUBLISH=git 时用：
# GIT_AUTHOR_NAME=node-bot
# GIT_AUTHOR_EMAIL=node-bot@localhost
# 用 token 推送（https）：
#   git remote set-url origin https://x-access-token:${GITHUB_TOKEN}@github.com/NZNL31/node.git

# --- 探活/校验 ---
# 可选：探活全部从指定代理出去，用来换「探测视角」（例如链到香港/新加坡出口）。
# 留空 = 直接用本机网络。支持 socks5:// 与 http://，可带用户名密码。
# 典型用法：PROBE_VIA=socks5://127.0.0.1:1080
PROBE_VIA=
# 探活实例的本地入站端口。默认 7890，被占用时自动往后找（服务器上 mihomo
# 常占 7890，撞上会 bind 失败，所以这里会自动避让，一般不用改）
PROBE_LISTEN_PORT=7890
# sing-box 不存在时 run.sh 会自动下载
SINGBOX_VERSION=1.14.4
SINGBOX_BIN=./sing-box

# 探活：并发与超时
MAX_PROBE=6000
PROBE_CONCURRENCY=64
PROBE_TIMEOUT_MS=4000

# 协议级校验（TCP 走 204，UDP 走 STUN）
VERIFY_SLOTS=24
VERIFY_TIMEOUT=8
# 端口段被占用时换一个（例如 Windows 保留段、或已被别的服务占用）
# VERIFY_PORT_BASE=15000

# 输出上限、淘汰节奏
MAX_OUTPUT=1500
DEAD_ROUNDS=2
MIN_KEEP=150

# 香港探测：默认关闭。服务器在哪都行，不需要靠 check-host.net 当代理探测点；
# 想让排序多一份「离中国有多近」的参考时再打开（公共免费服务，约 50 次后限流）
HK_PROBE=0
# 只发布香港测得通的节点（1/0）。香港是目前唯一与国内可用性正相关的信号，
# 但覆盖需要时间积累，低于 HK_ONLY_MIN 条时自动回退为全量发布
HK_ONLY=0
HK_ONLY_MIN=200
HK_BATCH=50
# 香港探测优先给 publishable.json 里的端点（上一轮通过 204/STUN 的），
# 把名额从 3000+ 收敛到几百个；没有这个文件时退回无偏轮转
HK_TTL_H=96
HK_PRUNE_DAYS=30

# 单源上限（巨型 dump 兜底）
SOURCE_LIMIT=1200
# --- 出口 IP 纯净度（结合 NZNL31/ipquality）--------------------------------
# 1 = 每轮都经节点查出口 IP 并打分，把 [A 96] 这样的标记写进节点名
PURITY=0
# ipquality 仓库位置（git clone 到项目旁边即可）
IPQUALITY_DIR=../ipquality
# 低于这个分数直接丢弃（0 = 只标注不筛）
PURITY_MIN=0
# 同一个出口 IP 的分数缓存多少天
PURITY_CACHE_DAYS=7
# 选优选：按纯净度挑出 N 个，输出 top{N}.txt（0 = 不选，只发全量 v2.txt）
# 数量由调用方决定，例如 TOP_N=80 ./run.sh；产物只留在本机，不提交
TOP_N=0
# 评分并发（ip-api 45 次/分、IPQS 35 次/天，别调太高）
PURITY_CONCURRENCY=4

# 候选池超过多少小时未更新就自己拉源（CI 挂了也不会停更）
CANDIDATES_MAX_AGE_H=6
